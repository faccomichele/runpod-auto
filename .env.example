# Local environment for this repo. Copy to `.env` and fill in your values:
#   cp .env.example .env        # Windows: Copy-Item .env.example .env
#
# `.env` is gitignored; this example file is committed. The tools auto-load the
# repo-root `.env` (client/generate.py, scripts/*.ps1, templates via
# scripts/tf.ps1). Real process environment variables always win over `.env`.
#
# Where each variable is used:
#   local tooling   -> client/generate.py, scripts/*.ps1, Terraform via scripts/tf.ps1
#   RunPod endpoint -> set the same values in the console under the endpoint's
#                      Environment Variables; the worker's bootstrap reads them
#                      there. The local `.env` cannot push variables to RunPod -
#                      treat it as the source of truth to copy from.
#
# Format: KEY=VALUE, optionally prefixed with `export`. Blank lines and lines
# starting with `#` are ignored. Quote values containing spaces or `#`.

# --- RunPod API (Terraform + client) ---
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_endpoint_id_here

# --- Model downloads (worker bootstrap; also used in pre-warm Pod terminals) ---
CIVITAI_TOKEN=your_civitai_api_token_here
# Only needed for gated Hugging Face repositories (e.g. FLUX.1-dev).
HF_TOKEN=your_huggingface_token_here

# --- Optional S3 output upload (worker env vars; phase 2 / large videos) ---
# Set these on the RunPod endpoint, not just locally.
# BUCKET_ENDPOINT_URL=https://my-bucket.s3.us-east-1.amazonaws.com
# BUCKET_ACCESS_KEY_ID=your_aws_access_key_id
# BUCKET_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- Optional: clone a private repo inside pre-warm Pods / CI ---
# GITHUB_TOKEN=your_github_token_here
