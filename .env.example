# Local environment for this repo. Copy to `.env` and fill in your values:
#   cp .env.example .env        # Windows: Copy-Item .env.example .env
#
# `.env` is gitignored; this example file is committed. The client auto-loads
# the repo-root `.env`. Real process environment variables always win over it.
# The RunPod endpoint's Cached Models repository and access token are configured
# in the RunPod console, not in this local file. Copy the worker settings below
# into the endpoint's Environment Variables section.
#
# Format: KEY=VALUE, optionally prefixed with `export`. Blank lines and lines
# starting with `#` are ignored. Quote values containing spaces or `#`.

# --- RunPod API (client) ---
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_endpoint_id_here

# --- RunPod worker Cached Models settings (set on the endpoint) ---
# Must exactly match the endpoint's Cached Models -> Model repository, using
# the org/repository form. The Hugging Face read token belongs in RunPod's
# Cached Models credential configuration and must not be stored here.
# HF_MODEL_ID=your-org/comfyui-models
# CACHED_MODELS_VERIFY_SHA=false
# Optional endpoint-only stale-cache diagnostic. This fetches only the root
# manifest; it never downloads or copies model files. Set HF_TOKEN separately
# as a RunPod endpoint secret when this is enabled. Do not put that token in
# this local .env file.
# CACHED_MODELS_FETCH_FRESH_MANIFEST=false
# HF_TOKEN=endpoint_secret_only

# --- Optional S3 output upload (worker env vars; phase 2 / large videos) ---
# Set these on the RunPod endpoint, not just locally.
# BUCKET_ENDPOINT_URL=https://my-bucket.s3.us-east-1.amazonaws.com
# BUCKET_ACCESS_KEY_ID=your_aws_access_key_id
# BUCKET_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- Optional: clone a private repo inside pre-warm Pods / CI ---
# GITHUB_TOKEN=your_github_token_here
